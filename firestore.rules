rules_version = '2';
// Reglas de seguridad de la base de datos.
// Se pegan en Firebase → Firestore Database → Reglas.
// Reemplazá TU_MAIL por el mail del administrador, todo en minúsculas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'TU_MAIL';
    }
    function isStaff() {
      return isOwner() ||
        (signedIn() && myEmail() in get(/databases/$(database)/documents/config/access).data.emails);
    }

    // Lista de mails habilitados: la leen todos, la cambia solo el administrador.
    match /config/access {
      allow read: if isStaff();
      allow write: if isOwner();
    }
    match /config/club {
      allow read, write: if isStaff();
    }
    // Perfil de cada integrante: cada uno escribe solo el suyo.
    match /members/{uid} {
      allow read: if isStaff();
      allow write: if isStaff() && request.auth.uid == uid;
    }
    // Rutinas enviadas a los jugadores: se abren con el link, sin cuenta.
    match /public/{id} {
      allow get: if true;
      allow write: if isStaff();
    }
    // Link personal de cada jugador: se abre sin cuenta y solo muestra su nombre y sus rutinas.
    match /plinks/{token} {
      allow get: if true;
    }
    // Bienestar y RPE que envía el jugador desde su link. Solo puede crear registros
    // a su nombre; leerlos, cambiarlos o borrarlos puede únicamente el cuerpo técnico.
    match /checkins/{id} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'player', 'kind', 'at', 'date',
            'sleep', 'fatigue', 'soreness', 'stress', 'painZone', 'note', 'activity', 'rpe', 'minutes'])
        && request.resource.data.token is string
        && request.resource.data.kind in ['well', 'rpe']
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.get('note', '').size() <= 400
        && request.resource.data.get('painZone', '').size() <= 80
        && exists(/databases/$(database)/documents/plinks/$(request.resource.data.token))
        && get(/databases/$(database)/documents/plinks/$(request.resource.data.token)).data.player == request.resource.data.player;
    }
    // Datos del equipo (plantel, sesiones, planificación, gimnasio, etc.).
    match /{col}/{id} {
      allow read, write: if isStaff() && !(col in ['config', 'members', 'public']);
    }
  }
}
